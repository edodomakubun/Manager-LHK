{
  "name": "lhk-cms-backend",
  "version": "1.0.0",
  "description": "Backend Cloudflare Workers untuk CMS Multi-User LHK",
  "main": "src/index.ts",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "d1:init": "wrangler d1 execute lhk-db --local --file=./schema.sql",
    "d1:init:prod": "wrangler d1 execute lhk-db --remote --file=./schema.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "docxtemplater": "^3.71.1",
    "hono": "^4.7.2",
    "jose": "^5.9.6",
    "pizzip": "^3.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250224.0",
    "typescript": "^5.7.3",
    "wrangler": "^3.111.0"
  }
}
